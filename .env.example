PORT=3000
DB_PATH=./duka.db

# WhatsApp Cloud API (Meta test number) — placeholders only, never real values.
#
# META_VERIFY_TOKEN    any string you invent; paste the SAME value into the
#                      Meta dashboard webhook config, then click Verify and Save
# META_ACCESS_TOKEN    WhatsApp > API Setup. The temporary token expires in 24h;
#                      use a System User token for anything longer-lived
# META_PHONE_NUMBER_ID the test number's ID (NOT the phone number itself)
# META_WABA_ID         WhatsApp Business Account ID
META_VERIFY_TOKEN=choose_any_random_string
META_ACCESS_TOKEN=your_meta_access_token
META_PHONE_NUMBER_ID=your_phone_number_id
META_WABA_ID=your_waba_id

ANTHROPIC_API_KEY=
