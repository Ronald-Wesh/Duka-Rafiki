{
  "name": "duka-rafiki",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node demo/seed-data.ts",
    "seed:statement": "ts-node demo/seed-statement.ts",
    "test:p3": "ts-node src/pillar3-statement/statement-metrics.test.ts",
    "check:intents": "ts-node demo/check-intents.ts",
    "check:seed": "ts-node demo/check-seed.ts",
    "check:prompts": "ts-node demo/check-prompts.ts",
    "check:prompts:live": "ts-node demo/check-prompts-live.ts",
    "check": "npm run check:intents && npm run check:lang && npm run check:seed && npm run check:prompts",
    "db:reset": "rm -f duka.db* && ts-node demo/seed-data.ts",
    "check:lang": "ts-node demo/check-language.ts",
    "dev:web": "npm --prefix web run dev"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.32.0",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "twilio": "^5.3.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
