# --- Secrets: never commit these -------------------------------------------
.env
.env.*
!.env.example

# --- Node ------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# --- TypeScript build output ------------------------------------------------
dist/
build/
*.tsbuildinfo

# --- SQLite demo database (regenerate with the seed script, never commit) ---
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/data/

# --- Generated statements / reports ----------------------------------------
/out/
*.pdf
!docs/**/*.pdf

# --- Local tunnels / tooling -----------------------------------------------
.ngrok*
*.log

# --- Editor / OS -----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp

# VS Code: keep shared settings, ignore personal ones
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- Claude Code local state ------------------------------------------------
.claude/settings.local.json
