# Union of P0's original rules (platform-infra) and the additions below.
# Nothing P0 ignored has been un-ignored.

# --- Secrets: never commit these -------------------------------------------
.env
.env.*
!.env.example

# --- Node ------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/

# --- TypeScript build output ------------------------------------------------
dist/
build/
*.tsbuildinfo

# --- SQLite demo database (regenerate with the seed script, never commit) ---
# duka.db is DB_PATH in .env.example. The -journal/-wal/-shm siblings are what
# better-sqlite3 leaves beside it; ignoring only *.db lets those get committed.
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/data/

# --- Generated statements / reports ----------------------------------------
/out/
*.pdf
!docs/**/*.pdf

# --- Local tunnels / tooling -----------------------------------------------
.ngrok*
*.log

# --- Editor / OS -----------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.swp

# VS Code: keep shared settings, ignore personal ones
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- Claude Code local state ------------------------------------------------
# P0's choice, kept as-is. Note the trade-off: this also excludes a shared
# .claude/settings.json, so team-wide Claude Code config can't be checked in.
# If the team wants that, narrow this to .claude/settings.local.json.
.claude/
references/SKILL.md
